namespace LowlandTech.Core.Plugins;

public sealed class IntentRegistry
{
    private readonly Dictionary<string, IIntentPlugin> _plugins = new(StringComparer.Ordinal);

    public void Register(IIntentPlugin plugin)
    {
        ArgumentNullException.ThrowIfNull(plugin);
        if (!_plugins.TryAdd(plugin.Type, plugin))
            throw new InvalidOperationException($"Intent plugin already registered: {plugin.Type}");
    }

    public IntentResult Dispatch(object state, string type, object intent)
    {
        if (!_plugins.TryGetValue(type, out var plugin))
            throw new InvalidOperationException($"Intent plugin is not registered: {type}");
        var next = plugin.Reduce(state, intent);
        return new(next, [$"{type}: dispatched"]);
    }
}
