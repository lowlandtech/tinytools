<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      The workspace feed: every LowlandTech package is published into
      D:/lowlandtech/packages. The path is relative to this repository so it
      resolves on every machine that has the workspace checked out, which is the
      same convention the builder and coder repositories use.

      The folder replaces the former local BaGet endpoint: BaGet served the same
      package set over http, so it added a network dependency and a startup step
      without adding a package. eng cannot publish into the feed from this lane;
      packages are produced by their owning lane and copied there.
    -->
    <add key="lowlandtech-local" value="../packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="lowlandtech-local">
      <package pattern="LowlandTech.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
