@page "/"
@using LowlandTech.TinyTools.Playground

<PageTitle>Tinytools playground</PageTitle>

<h1>TinyTools playground</h1>
<p class="lead">Render a template against a JSON model with the engine compiled to WebAssembly.</p>

<div class="grid">
    <label>
        Template
        <textarea id="input-template" @bind="session.Template" @bind:event="oninput" spellcheck="false"></textarea>
    </label>
    <label>
        Model
        <textarea id="input-model" @bind="session.Model" @bind:event="oninput" spellcheck="false"></textarea>
    </label>
</div>

<button id="render" @onclick="Render">Render</button>

<h2>Output</h2>
<pre class="output">@session.Output</pre>

@if (session.DiagnosticCode is not null)
{
    <p class="diagnostic">@session.DiagnosticCode</p>
}

<h2>Use it</h2>

<div class="snippet">
    <div>
        <pre id="snippet-csharp">@session.CSharpSnippet</pre>
        <button class="copy" id="copy-csharp" @onclick="() => CopyAsync(session.CSharpSnippet)">Copy C#</button>
    </div>
    <div>
        <pre id="snippet-workflow">@session.WorkflowSnippet</pre>
        <button class="copy" id="copy-workflow" @onclick="() => CopyAsync(session.WorkflowSnippet)">Copy YAML</button>
    </div>
    <div>
        <pre id="snippet-cli">@session.CommandSnippet</pre>
        <button class="copy" id="copy-cli" @onclick="() => CopyAsync(session.CommandSnippet)">Copy CLI</button>
    </div>
</div>

@if (CopyStatus is not null)
{
    <p class="copy-status">@CopyStatus</p>
}

<p class="version">Engine @Version</p>

@code {
    [Inject]
    private PlaygroundSession session { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private static string Version => typeof(TinyTemplateEngine).Assembly.GetName().Version?.ToString() ?? "unknown";

    private string? CopyStatus { get; set; }

    protected override void OnInitialized() => session.Render();

    private void Render() => session.Render();

    private async Task CopyAsync(string text)
    {
        var copied = await JS.InvokeAsync<bool>("tinytoolsCopy", text);
        CopyStatus = copied
            ? "Copied to the clipboard."
            : "The browser refused the clipboard write; select the text instead.";
    }
}
