<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LowlandTech.TinyTools.Playground.Web</RootNamespace>
    <AssemblyName>LowlandTech.TinyTools.Playground.Web</AssemblyName>
    <!-- Published into the Pages artifact by the docs workflow, never packed. -->
    <IsPackable>false</IsPackable>
    <BlazorEnableCompression>false</BlazorEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <ProjectReference Include="..\playground\LowlandTech.TinyTools.Playground.csproj" />
  </ItemGroup>

</Project>
