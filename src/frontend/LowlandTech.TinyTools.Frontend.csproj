<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LowlandTech.TinyTools.Frontend</RootNamespace>
    <AssemblyName>LowlandTech.TinyTools.Frontend</AssemblyName>
    <!-- The Razor frontend package the Harness composes. It is packable from the
         start so the store, the page and the assets live in the package that
         ships them, not in the development host. -->
    <IsPackable>true</IsPackable>
    <PackageId>LowlandTech.TinyTools.Frontend</PackageId>
    <Authors>LowlandTech</Authors>
    <Company>LowlandTech</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>The Templates surface of the Tinytools application: the store, the page and the assets a Harness deployment composes.</Description>
    <PackageTags>lowlandtech tinytools templates blazor frontend</PackageTags>
    <RepositoryUrl>https://github.com/lowlandtech/tinytools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Every declared asset path starts with this root, so _content/<PackageId>/ resolves. -->
    <StaticWebAssetBasePath>_content/LowlandTech.TinyTools.Frontend</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin descriptor travels with the package twice: packed so a host can read it from
         the archive, and embedded so a composed host can read it without touching disk. The asset
         root is the same prefix every declared stylesheet and script uses. -->
    <None Include="lowlandtech\plugin.json" Pack="true" PackagePath="lowlandtech\" />
    <EmbeddedResource Include="lowlandtech\plugin.json" LogicalName="lowlandtech/plugin.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page renders the shared Components surface, so the package declares it the way the other Harness plugins do. -->
    <PackageReference Include="LowlandTech.Components" Version="2026.10.2-202610242" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\LowlandTech.TinyTools.Core.csproj" />
  </ItemGroup>

</Project>
