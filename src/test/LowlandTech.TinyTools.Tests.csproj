<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentAssertions" Version="8.10.0" />
		<PackageReference Include="Humanizer" Version="3.0.10" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
		<PackageReference Include="NCalcSync" Version="6.3.2" />
		<PackageReference Include="xunit.v3" Version="3.2.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector" Version="10.0.1">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<ProjectReference Include="..\core\LowlandTech.TinyTools.Core.csproj" />
		<ProjectReference Include="..\lib\LowlandTech.TinyTools.csproj" />
		<ProjectReference Include="..\infrastructure\LowlandTech.TinyTools.Tests.Infrastructure.csproj" />
	</ItemGroup>

	<!-- The API host and the Razor frontend target net10.0 only, so their specs
	     exist on that target framework and the scenario sources are guarded with
	     NET10_0_OR_GREATER. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
		<PackageReference Include="bunit" Version="2.7.2" />
		<!-- The generator fixture compiles a consumer in memory, so this project needs the
		     same Roslyn the analyzer targets. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
		<ProjectReference Include="..\generators\LowlandTech.TinyTools.Generators.csproj" />
		<ProjectReference Include="..\api\LowlandTech.TinyTools.Api.csproj" />
		<!-- Both hosts declare a top-level entry point, so the page scenarios reach
		     the app through an alias and keep API's Program unambiguous. -->
		<ProjectReference Include="..\app\LowlandTech.TinyTools.App.csproj" Aliases="app" />
		<ProjectReference Include="..\frontend\LowlandTech.TinyTools.Frontend.csproj" />
		<Using Include="Bunit" />
	</ItemGroup>

	<ItemGroup>
		<None Update="files.zip">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<!-- A template embedded in this assembly, so the RazorLight compatibility
		     embedded-resource project path is exercised by a real resource lookup. -->
		<EmbeddedResource Include="EmbeddedTemplate.cshtml"
		                  LogicalName="LowlandTech.TinyTools.Tests.SPEC3300.TemplateEngine.US11.RazorLightCache.EmbeddedTemplate.cshtml" />
	</ItemGroup>

</Project>