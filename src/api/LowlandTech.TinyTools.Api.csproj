<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LowlandTech.TinyTools.Api</RootNamespace>
    <AssemblyName>LowlandTech.TinyTools.Api</AssemblyName>
    <!-- The host is a development entry point until the plugin packaging item
         makes it a served package. -->
    <IsPackable>true</IsPackable>
    <PackageId>LowlandTech.TinyTools.Api</PackageId>
    <Authors>LowlandTech</Authors>
    <Company>LowlandTech</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>The template API of the Tinytools application: the DbContext and the resource-based /api/templates endpoints a Harness deployment composes.</Description>
    <PackageTags>lowlandtech tinytools templates backend</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="lowlandtech\plugin.json" Pack="true" PackagePath="lowlandtech\" />
    <None Include="lowlandtech\deployment.json" Pack="true" PackagePath="lowlandtech\" />
    <EmbeddedResource Include="lowlandtech\deployment.json" LogicalName="lowlandtech/deployment.json" />
    <EmbeddedResource Include="lowlandtech\plugin.json" LogicalName="lowlandtech/plugin.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LowlandTech.Plugins.Domain" Version="[2026.10.1-20261102113735045740153]" />
    <PackageReference Include="LowlandTech.Plugins" Version="[2026.10.1-20261102113735045740153]" />
    <PackageReference Include="LowlandTech.Core" Version="[2026.10.3-20261101231129]" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\LowlandTech.TinyTools.Core.csproj" />
    <ProjectReference Include="..\lib\LowlandTech.TinyTools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="TinyToolsPluginVersion" Value="$(Version)" />
  </ItemGroup>

</Project>
