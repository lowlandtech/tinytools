<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LowlandTech.TinyTools.App</RootNamespace>
    <AssemblyName>LowlandTech.TinyTools.App</AssemblyName>
    <!-- The development host. The packaged contribution is the Razor frontend
         package, so this project is never packed. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LowlandTech.Components" Version="2026.10.2-202610242" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\LowlandTech.TinyTools.Core.csproj" />
    <ProjectReference Include="..\frontend\LowlandTech.TinyTools.Frontend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Tailwind sources are inputs of the CSS build, not runtime assets. The
      built wwwroot/app.css is authoritative and committed, so a machine without
      Node still serves the same styles through SkipTailwindBuild=true.
    -->
    <Content Remove="wwwroot\node_modules\**" />
    <Content Remove="wwwroot\package.json" />
    <Content Remove="wwwroot\package-lock.json" />
    <Content Remove="wwwroot\css\**" />
    <None Remove="wwwroot\node_modules\**" />
    <None Remove="wwwroot\package.json" />
    <None Remove="wwwroot\package-lock.json" />
    <None Remove="wwwroot\css\**" />
  </ItemGroup>

  <!--
    Builds wwwroot/app.css from wwwroot/css/input.css. Set SkipTailwindBuild=true
    to use the committed app.css on a machine without Node; nothing else changes.
  -->
  <Target Name="BuildTailwindCSS" BeforeTargets="BeforeBuild" Condition="'$(SkipTailwindBuild)' != 'true'">
    <PropertyGroup>
      <WwwRootPath>$(MSBuildProjectDirectory)/wwwroot</WwwRootPath>
      <NodeModulesPath>$(WwwRootPath)/node_modules</NodeModulesPath>
    </PropertyGroup>
    <Exec Command="npm install" WorkingDirectory="$(WwwRootPath)" Condition="!Exists('$(NodeModulesPath)')" ConsoleToMSBuild="true" IgnoreExitCode="false" />
    <Exec Command="npm run build:css" WorkingDirectory="$(WwwRootPath)" ConsoleToMSBuild="true" IgnoreExitCode="false" />
  </Target>

</Project>
