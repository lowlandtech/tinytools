@page "/templates"
@using LowlandTech.TinyTools.App.Components
@using LowlandTech.TinyTools.Frontend.Features.Templates
@implements IDisposable
@inject TemplateSessionStore Store
@inject TemplateEffects Effects

<h1 class="page-title">Templates</h1>

@if (_error is not null)
{
    <p class="alert alert-destructive" role="alert">@_error</p>
}

<p class="label">@Store.State.AllItems.Count template(s)</p>

@if (Store.State.AllItems.Count == 0 && _error is null)
{
    <p class="label">No templates yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Versions</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var template in Store.State.AllItems)
            {
                <tr @key="template.Id">
                    <td>@template.Name</td>
                    <td>@template.Versions.Count</td>
                    <td>@(template.IsActive ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string? _error;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            await Effects.LoadAsync(Store);
            _error = null;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException)
        {
            _error = $"The template library is unavailable: {exception.Message}";
        }
        finally
        {
            _loaded = true;
        }
    }

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Store.Changed -= OnStoreChanged;
}
