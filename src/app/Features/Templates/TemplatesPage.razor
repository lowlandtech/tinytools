@page "/templates"
@using LowlandTech.Components
@using LowlandTech.TinyTools.App.Components
@using LowlandTech.TinyTools.Core.Entities
@using LowlandTech.TinyTools.Frontend.Features.Templates
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject TemplateSessionStore Store
@inject TemplateEffects Effects

<PageTitle>Templates</PageTitle>

<div class="flex items-center justify-between gap-4 py-4">
    <h1 class="text-xl font-semibold">Templates</h1>
    <div class="flex items-center gap-2">
        <Button Variant="outline" Size="sm" @onclick="RefreshAsync">Refresh</Button>
        <Button Variant="default" Size="sm" @onclick="BeginCreate">New template</Button>
    </div>
</div>

@if (_error is not null)
{
    <p class="alert alert-destructive" role="alert">@_error</p>
}

<DataGrid TItem="Template" Items="@Store.State.AllItems" EmptyText="No templates yet.">
    <Columns>
        <DataGridColumn TItem="Template" Property="Name" Title="Name" />
        <DataGridColumn TItem="Template" Property="Versions.Count" Title="Versions" />
        <DataGridColumn TItem="Template" Title="Active">
            <Template>@(context.IsActive ? "Yes" : "No")</Template>
        </DataGridColumn>
    </Columns>
</DataGrid>

@code {
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        await LoadAsync();
    }

    private async Task RefreshAsync() => await LoadAsync();

    private void BeginCreate() => Store.Dispatch(new TemplateSetCreateContext("templates", "template", null));

    private async Task LoadAsync()
    {
        try
        {
            await Effects.LoadAsync(Store);
            _error = null;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException)
        {
            _error = $"The template library is unavailable: {exception.Message}";
        }
    }

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Store.Changed -= OnStoreChanged;
}
